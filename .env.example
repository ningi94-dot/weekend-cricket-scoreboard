NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Add these in Vercel, not in browser code.
SUPABASE_SERVICE_ROLE_KEY=
SCORER_SESSION_SECRET=
SCORER_PASSWORD_SALT=
SCORER_PASSWORD_HASH=
CAPTAIN_PASSWORD_SALT=
CAPTAIN_PASSWORD_HASH=

# Server-only Cricket AI configuration. Never prefix these with NEXT_PUBLIC_.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna
AI_MONTHLY_BUDGET_USD=10
# Override these only when the selected model's published pricing changes.
AI_INPUT_COST_PER_MILLION_USD=0.10
AI_OUTPUT_COST_PER_MILLION_USD=0.50
