NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Add these in Vercel, not in browser code.
SUPABASE_SERVICE_ROLE_KEY=
SCORER_SESSION_SECRET=
SCORER_PASSWORD_SALT=
SCORER_PASSWORD_HASH=
CAPTAIN_PASSWORD_SALT=
CAPTAIN_PASSWORD_HASH=

# Server-only Cricket AI configuration. Never prefix these with NEXT_PUBLIC_.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_MONTHLY_BUDGET_USD=10
# Gemini's free tier has no token charge. Update these if you move to paid usage.
AI_INPUT_COST_PER_MILLION_USD=0
AI_OUTPUT_COST_PER_MILLION_USD=0

# Optional OpenAI alternative. Set AI_PROVIDER=openai and use its model/pricing.
OPENAI_API_KEY=
